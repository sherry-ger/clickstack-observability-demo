#!/bin/sh
# One project session can investigate and save its findings. Credentials stay in
# the environment; source edits and destructive delete tools are not exposed.
set -eu
project_root=$(CDPATH= cd -P "$(dirname "$0")/../.." && pwd)
command -v python3 >/dev/null 2>&1 || { echo 'Python 3.11+ is required on PATH.' >&2; exit 1; }
exec python3 "$project_root/scripts/launch_mcp.py" "$@"
