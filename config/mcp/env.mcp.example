# Personal API access key from the local ClickStack user's profile.
# This is NOT the HYPERDX_API_KEY used for telemetry ingestion.
# Copy to the project root as .env.mcp, chmod 600 .env.mcp, and fill locally.
CLICKSTACK_MCP_API_KEY=
# Optional Slack incoming-webhook URL. Set privately in the root .env.mcp.
# Register it with: python3 scripts/configure_slack_webhook.py --register
# The MCP workflow then uses the saved webhook ID, not the secret URL.
CLICKSTACK_SLACK_WEBHOOK_URL=
