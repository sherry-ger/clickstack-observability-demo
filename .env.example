# Local demo only. Real values belong in .env (ignored).
HYPERDX_API_KEY=
POSTGRES_PASSWORD=replace-with-random-local-password
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=demo
CLICKHOUSE_PASSWORD=replace-with-random-local-password
CLICKHOUSE_DATABASE=default

# Investigator traces only. Host is the Langfuse Cloud origin, without /api paths.
LANGFUSE_HOST=https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Optional isolation settings; defaults preserve the normal trainer URLs/names.
COMPOSE_PROJECT_NAME=kubecon-training
KUBECON_CONTAINER_PREFIX=kubecon
KUBECON_APP_PORT=8000
KUBECON_DOCS_PORT=8001
KUBECON_UI_PORT=8080
KUBECON_OTLP_GRPC_PORT=4317
KUBECON_OTLP_HTTP_PORT=4318

# Optional separate investigator collector context (native spans -> this ClickStack).
KUBECON_INVESTIGATOR_PROJECT=kubecon-investigator
KUBECON_INVESTIGATOR_CONTAINER=kubecon-investigator-collector
KUBECON_INVESTIGATOR_OTLP_PORT=14318
KUBECON_INVESTIGATOR_HEALTH_PORT=14333
